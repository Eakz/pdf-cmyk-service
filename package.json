{
  "name": "pdf-cmyk-service",
  "version": "1.0.0",
  "description": "Microservice tool to transform RGB pdfs to CMYK",
  "main": "index.ts",
  "repository": "https://github.com/Eakz/pdf-cmyk-service.git",
  "author": "EakzIT",
  "scripts": {
    "prepare": "husky install",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "start": "node dist/src/app.js",
    "upgrade-all": "yarn yarn-upgrade-all",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --config .prettierrc src/* --write"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "yarn lint",
      "yarn format"
    ]
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "yarn-upgrade-all": "^0.7.5"
  },
  "license": "MIT",
  "private": true
}
